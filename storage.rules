rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function requesterRole() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isManagerOrAdmin() {
      return signedIn()
        && requesterRole() is string
        && requesterRole().matches('[\\s\\S]*([Mm][Aa][Nn][Aa][Gg][Ee][Rr]|[Aa][Dd][Mm][Ii][Nn])[\\s\\S]*');
    }

    match /documents/{allPaths=**} {
      allow read:  if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isManagerOrAdmin();
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /payslips/{employeeId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == employeeId || isManagerOrAdmin());
      allow write: if isManagerOrAdmin() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
