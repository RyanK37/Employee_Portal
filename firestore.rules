rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function requesterRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isManagerOrAdmin() {
      return signedIn()
        && requesterRole() is string
        && requesterRole().matches('[\\s\\S]*([Mm][Aa][Nn][Aa][Gg][Ee][Rr]|[Aa][Dd][Mm][Ii][Nn])[\\s\\S]*');
    }

    function isAnnouncementMessage(data) {
      return data.roomId == 'channel_announcements';
    }

    function isPrivateMessage(data) {
      return data.roomType == 'dm' || data.roomType == 'group';
    }

    function canAccessMessage(data) {
      return !isPrivateMessage(data) || request.auth.uid in data.memberIds;
    }

    function isOwnPublishedPayroll(data) {
      return signedIn()
        && request.auth.uid == data.employeeId
        && data.status == 'published';
    }

    function isAnnouncementReactionUpdate() {
      return isAnnouncementMessage(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likedBy', 'dislikedBy']);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'Employee';
      allow update: if (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'displayName',
            'department',
            'office',
            'mood',
            'mbti',
            'preferences'
          ])
        ) || (
          isManagerOrAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'mbti',
            'mbtiUpdatedAt',
            'mbtiSource',
            'leaveBalance',
            'leaveBalance.used',
            'leaveBalance.remaining',
            'leaveTaken'
          ])
        );
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow create, update: if isManagerOrAdmin();
    }

    match /leaveRequests/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isManagerOrAdmin();
    }

    match /chatRooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
    }

    match /messages/{docId} {
      allow read: if signedIn() && (isManagerOrAdmin() || canAccessMessage(resource.data));
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && canAccessMessage(request.resource.data)
        && (!isAnnouncementMessage(request.resource.data) || isManagerOrAdmin());
      allow update: if signedIn() && isAnnouncementReactionUpdate();
    }

    match /notifications/{docId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /payrollEntries/{docId} {
      allow read: if isManagerOrAdmin() || isOwnPublishedPayroll(resource.data);
      allow create, update: if isManagerOrAdmin();
    }

    match /payrollAuditLogs/{docId} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin();
    }

    match /documents/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if isManagerOrAdmin();
    }
  }
}
